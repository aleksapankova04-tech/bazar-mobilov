<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bazar Mobilov</title>
  <!-- Подключаем инструмент Telegram, чтобы страничка знала, что она в Telegram -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0d1017;
      color: #ffffff;
      padding: 16px;
    }
    .banner {
      background: linear-gradient(135deg, #1d3557, #3a0ca3);
      padding: 18px;
      border-radius: 16px;
      margin-bottom: 14px;
    }
    .banner h1 {
      margin: 0 0 6px;
      font-size: 22px;
    }
    .filters {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      margin-bottom: 14px;
    }
    .filter-btn {
      background: #1b2230;
      color: #fff;
      border: 1px solid #2c364b;
      padding: 8px 14px;
      border-radius: 20px;
      cursor: pointer;
    }
    .filter-btn.active {
      background: #2b7fff;
      border-color: #2b7fff;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .card {
      background: #161b26;
      border-radius: 14px;
      padding: 10px;
    }
    .card img {
      width: 100%;
      height: 110px;
      object-fit: cover;
      border-radius: 10px;
      background: #242c3d;
    }
    .title {
      font-weight: bold;
      margin: 8px 0 4px;
      font-size: 14px;
    }
    .price {
      color: #6ea8fe;
      font-weight: bold;
      margin-bottom: 8px;
    }
    .buy-btn {
      display: inline-block;
      text-decoration: none;
      background: #2b7fff;
      color: #fff;
      padding: 6px 10px;
      border-radius: 8px;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="banner">
    <h1>Bazar Mobilov</h1>
    <div>Купи • Продавай • Обменивай</div>
  </div>

  <div class="filters">
    <button class="filter-btn active" onclick="filterItems('Все', this)">Все</button>
    <button class="filter-btn" onclick="filterItems('iPhone', this)">iPhone</button>
    <button class="filter-btn" onclick="filterItems('Samsung', this)">Samsung</button>
  </div>

  <div class="grid" id="itemsGrid"></div>

  <script>
    const tg = window.Telegram.WebApp;
    tg.ready(); // Говорим Telegram: «Мы готовы, показывай экран!»

    // Пока товары записаны прямо здесь, как в блокноте
    const items = [
      {
        title: "iPhone 15 Pro",
        brand: "iPhone",
        price: "799 €",
        seller: "durov", // сюда подставишь username продавца без @
        img: "https://via.placeholder.com/300x200?text=iPhone+15+Pro"
      },
      {
        title: "Samsung Galaxy S24 Ultra",
        brand: "Samsung",
        price: "849 €",
        seller: "durov",
        img: "https://via.placeholder.com/300x200?text=S24+Ultra"
      }
    ];

    function renderItems(list) {
      const grid = document.getElementById("itemsGrid");
      grid.innerHTML = "";
      list.forEach(item => {
        grid.innerHTML += `
          <div class="card">
            <img src="${item.img}" alt="${item.title}" />
            <div class="title">${item.title}</div>
            <div class="price">${item.price}</div>
            <a class="buy-btn" href="https://t.me/${item.seller}" target="_blank">Написать</a>
          </div>
        `;
      });
    }

    function filterItems(brand, btn) {
      document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      if (brand === "Все") {
        renderItems(items);
      } else {
        renderItems(items.filter(i => i.brand === brand));
      }
    }

    renderItems(items);
  </script>
</body>
</html>
